pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                bat 'node -v'
                bat 'npm -v'
                bat 'git --version'
            }
        }

        stage('Install Packages') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build Vue Project') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Finish') {
            steps {
                echo 'Practice Jenkins pipeline completed successfully.'
            }
        }
    }
}